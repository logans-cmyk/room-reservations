<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Blair Academy — Room Reservations</title>
<style>
  /* ── PASTE YOUR APPS SCRIPT DEPLOYMENT URL ON LINE 1 OF THE <script> BLOCK BELOW ── */

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --navy:   #002244;
    --blue:   #004b8d;
    --mid:    #093266;
    --teal:   #00b2ba;
    --teal-d: #0f6e56;
    --orange: #f15d22;
    --orange-d: #c6671d;
    --red:    #da1a32;
    --red-d:  #a32d2d;
    --light:  #e6f1fb;
    --green:  #74a333;
    --green-d:#3b6d11;
    --gray-bg:#f5f5f5;
    --gray-border: #d8d8d8;
    --text:   #1a1a1a;
    --text-muted: #666;
    --white:  #ffffff;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    font-size: 14px;
    color: var(--text);
    background: var(--gray-bg);
    min-height: 100vh;
  }

  /* ── HEADER ── */
  .header {
    background: var(--navy);
    color: white;
    padding: 0 24px;
    display: flex;
    align-items: center;
    gap: 18px;
    height: 68px;
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }
  .header-logo-img {
    height: 52px;
    width: auto;
    flex-shrink: 0;
  }
  .header-text-block { display: flex; flex-direction: column; justify-content: center; }
  .header-sub {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    line-height: 1.2;
    margin-bottom: 2px;
  }
  .header h1 {
    font-size: 18px;
    font-weight: 500;
    color: white;
    margin: 0;
    white-space: nowrap;
  }
  .header-div { width: 1px; height: 36px; background: rgba(255,255,255,0.18); flex-shrink: 0; }
  .header-est { font-size: 11px; color: rgba(255,255,255,0.35); letter-spacing: 0.1em; margin-left: auto; white-space: nowrap; }

  /* ── LAYOUT ── */
  .app { display: flex; height: calc(100vh - 56px); overflow: hidden; }

  /* ── SIDEBAR ── */
  .sidebar {
    width: 230px;
    flex-shrink: 0;
    background: var(--white);
    border-right: 1px solid var(--gray-border);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  .sidebar-inner { padding: 16px; display: flex; flex-direction: column; gap: 18px; }
  .section-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 8px;
  }
  .room-btn {
    width: 100%; text-align: left; background: none;
    border: 1px solid var(--gray-border);
    border-radius: 6px; padding: 8px 10px; cursor: pointer;
    display: flex; align-items: center; gap: 8px;
    transition: background 0.12s, border-color 0.12s;
  }
  .room-btn:hover { background: var(--gray-bg); }
  .room-btn.active { background: var(--light); border-color: var(--blue); }
  .room-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
  .room-name { font-size: 12px; color: var(--text); font-weight: 500; line-height: 1.3; }

  .legend-item { display: flex; align-items: center; gap: 7px; font-size: 12px; color: var(--text-muted); margin-bottom: 6px; }
  .legend-swatch { width: 14px; height: 14px; border-radius: 3px; flex-shrink: 0; }

  .sidebar-tip { font-size: 11px; color: var(--text-muted); line-height: 1.7; padding: 10px; background: var(--gray-bg); border-radius: 6px; border: 1px solid var(--gray-border); }

  /* ── MAIN CONTENT ── */
  .content { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

  .toolbar {
    background: var(--white);
    border-bottom: 1px solid var(--gray-border);
    padding: 12px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }
  .date-nav-btn {
    background: none; border: 1px solid var(--gray-border);
    border-radius: 6px; width: 44px; height: 44px; cursor: pointer;
    font-size: 22px; color: var(--text-muted);
    display: flex; align-items: center; justify-content: center;
    transition: background 0.1s; flex-shrink: 0;
  }
  .date-nav-btn:hover { background: var(--gray-bg); }
  .date-display { font-size: 15px; font-weight: 600; color: var(--text); flex: 1; }
  .today-btn {
    background: none; border: 1px solid var(--gray-border);
    border-radius: 6px; padding: 10px 16px; font-size: 13px;
    cursor: pointer; color: var(--text-muted); transition: background 0.1s;
  }
  .today-btn:hover { background: var(--gray-bg); }
  .new-btn {
    background: var(--teal); color: white; border: none;
    border-radius: 6px; padding: 8px 16px; font-size: 13px;
    font-weight: 600; cursor: pointer; display: flex; align-items: center;
    gap: 6px; transition: background 0.12s;
  }
  .new-btn:hover { background: var(--teal-d); }

  /* ── STATUS BAR ── */
  .status-bar {
    padding: 6px 20px;
    background: var(--light);
    border-bottom: 1px solid #b5d4f4;
    font-size: 12px;
    color: var(--blue);
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .status-bar.loading { background: #fff8f0; border-color: #f5c4b3; color: var(--orange-d); }
  .status-bar.error   { background: #fcebeb; border-color: #f7c1c1; color: var(--red-d); }
  .status-bar.hidden  { display: none; }
  .spinner { width: 12px; height: 12px; border: 2px solid currentColor; border-top-color: transparent; border-radius: 50%; animation: spin 0.7s linear infinite; flex-shrink: 0; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── TIMELINE ── */
  .timeline-scroll { flex: 1; overflow: auto; padding: 16px 20px 24px; }
  .tgrid {
    display: grid;
    border: 1px solid var(--gray-border);
    border-radius: 8px;
    overflow: hidden;
    min-width: 900px;
    background: var(--white);
  }
  .th {
    background: var(--navy);
    color: rgba(255,255,255,0.8);
    padding: 6px 3px;
    font-size: 10px;
    font-weight: 600;
    text-align: center;
    border-right: 1px solid rgba(255,255,255,0.1);
    white-space: nowrap;
    letter-spacing: 0.03em;
  }
  .th.corner { border-right: 1px solid rgba(255,255,255,0.15); }
  .tlabel {
    background: #f8f9fb;
    padding: 6px 10px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    border-right: 1px solid var(--gray-border);
    border-bottom: 1px solid var(--gray-border);
    display: flex;
    align-items: center;
    min-height: 56px;
    line-height: 1.35;
    word-break: break-word;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .tlabel.last-row { border-bottom: none; }
  .tcell {
    position: relative;
    border-right: 1px solid #eee;
    border-bottom: 1px solid #eee;
    height: 56px;
    cursor: pointer;
    transition: background 0.08s;
  }
  .tcell:hover { background: #eaf3de; }
  .tcell.last-col { border-right: none; }
  .tcell.last-row { border-bottom: none; }
  .tcell.occupied { cursor: default; }
  .tcell.occupied:hover { background: transparent; }

  .bblock {
    position: absolute;
    top: 3px; left: 2px; bottom: 3px;
    border-radius: 4px;
    display: flex; align-items: center;
    padding: 0 7px;
    font-size: 11px; font-weight: 600;
    cursor: pointer;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    z-index: 2;
    color: white;
    transition: opacity 0.1s;
  }
  .bblock:hover { opacity: 0.88; }

  /* ── MODAL ── */
  .modal-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.45);
    display: flex; align-items: center; justify-content: center;
    z-index: 200;
    padding: 16px;
  }
  .modal {
    background: var(--white);
    border-radius: 10px;
    padding: 24px;
    width: 400px;
    max-width: 100%;
    box-shadow: 0 8px 40px rgba(0,0,0,0.2);
  }
  .modal-header { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; }
  .modal-header h2 { font-size: 16px; font-weight: 600; color: var(--text); margin: 0; }
  .modal-icon { width: 32px; height: 32px; border-radius: 8px; background: #fff3ee; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
  .frow { margin-bottom: 13px; }
  .frow label { display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.06em; }
  .frow input, .frow select, .frow textarea {
    width: 100%;
    border: 1px solid var(--gray-border);
    border-radius: 6px;
    padding: 8px 10px;
    font-size: 13px;
    font-family: inherit;
    color: var(--text);
    background: var(--white);
    transition: border-color 0.12s;
  }
  .frow input:focus, .frow select:focus, .frow textarea:focus { outline: none; border-color: var(--blue); }
  .frow input[readonly] { background: var(--gray-bg); color: var(--text-muted); }
  .frow textarea { height: 60px; resize: vertical; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .modal-actions { display: flex; gap: 10px; margin-top: 18px; }
  .btn-cancel {
    flex: 1; background: none; border: 1px solid var(--gray-border);
    border-radius: 6px; padding: 9px; font-size: 13px;
    cursor: pointer; color: var(--text-muted); font-family: inherit;
    transition: background 0.1s;
  }
  .btn-cancel:hover { background: var(--gray-bg); }
  .btn-confirm {
    flex: 2; background: var(--orange); color: white; border: none;
    border-radius: 6px; padding: 9px; font-size: 13px;
    font-weight: 600; cursor: pointer; font-family: inherit;
    transition: background 0.12s;
  }
  .btn-confirm:hover { background: var(--orange-d); }
  .btn-confirm.danger { background: var(--red); }
  .btn-confirm.danger:hover { background: var(--red-d); }

  .detail-box {
    background: var(--gray-bg);
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 14px;
    border: 1px solid var(--gray-border);
  }
  .detail-box h3 { font-size: 15px; font-weight: 600; margin-bottom: 10px; color: var(--text); }
  .drow { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 5px; }
  .drow span { color: var(--text-muted); }
  .drow strong { color: var(--text); text-align: right; max-width: 60%; }
  .mine-badge { margin-top: 10px; font-size: 11px; font-weight: 600; color: var(--red-d); display: flex; align-items: center; gap: 5px; }

  /* ── TOAST ── */
  .toast {
    position: fixed; bottom: 24px; left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: var(--navy); color: white;
    border-radius: 8px; padding: 11px 22px;
    font-size: 13px; font-weight: 500;
    z-index: 300; opacity: 0;
    transition: opacity 0.25s, transform 0.25s;
    pointer-events: none; white-space: nowrap;
    box-shadow: 0 4px 16px rgba(0,0,0,0.25);
  }
  .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  .toast.success { background: var(--teal); }
  .toast.error-t  { background: var(--red-d); }
</style>
</head>
